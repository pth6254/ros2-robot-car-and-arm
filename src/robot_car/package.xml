<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_car</name>
  <version>0.1.0</version>
  <description>Arduino 2WD differential drive robot: URDF, PyBullet simulation, WASD teleop</description>
  <maintainer email="117342307+pth6254@users.noreply.github.com">pth6254</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- pybullet 은 pip 로 설치: pip install pybullet -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
