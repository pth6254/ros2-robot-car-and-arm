Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.2
      Show Names: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Keep: 200
      Position Tolerance: 0.02
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Shaft Length: 0.08
        Shaft Radius: 0.005
        Head Length: 0.03
        Head Radius: 0.012
        Color: 255; 25; 0
    # 앞쪽 IR 장애물 센서: 감지되면 센서 앞에 노란 원뿔(감지 구역)이 나타남
    - Class: rviz_default_plugins/Range
      Name: IR left
      Enabled: true
      Topic:
        Value: /ir/left
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Buffer Length: 1
      Color: 255; 200; 0
      Alpha: 0.5
    - Class: rviz_default_plugins/Range
      Name: IR right
      Enabled: true
      Topic:
        Value: /ir/right
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Buffer Length: 1
      Color: 255; 200; 0
      Alpha: 0.5
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: base_link
      Focal Point:
        X: 0
        Y: 0
        Z: 0
